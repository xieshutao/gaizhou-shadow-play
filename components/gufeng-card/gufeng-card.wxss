/* ═══════════════════════════════════════════════
   古风列表卡片 · 盖州皮影戏非遗文化
   设计来源：用户上传 Figma/SVG 设计稿
   配色：#DB511F(暖红褐) #F0DFA3(古金) #A07345(木棕) #F9F9F9(底)
   字体：AlimamaDongFangDaKai（阿里巴巴东方大楷）
   ═══════════════════════════════════════════════ */

/* ── 卡片容器 ── */
.gf-card {
  margin: 24rpx 28rpx;
  background: #F9F9F9;
  background: var(--gf-bg, #F9F9F9);
  border: 2rpx solid #A07345;
  border: 2rpx solid var(--gf-brown, #A07345);
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(160, 115, 69, 0.12);
}

/* ── 装饰线: 顶部 ── */
.gf-ornament-top {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 0;
  gap: 12rpx;
}

.gf-ornament-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #A07345, transparent);
}

.gf-ornament-diamond {
  width: 12rpx;
  height: 12rpx;
  background: #DB511F;
  transform: rotate(45deg);
  opacity: 0.7;
}

/* ── 标题区 ── */
.gf-header {
  text-align: center;
  padding: 12rpx 32rpx 0;
}

.gf-title {
  font-family: "AlimamaDongFangDaKai";
  font-size: 40rpx;
  font-weight: 700;
  color: #DB511F;
  letter-spacing: 6rpx;
  line-height: 1.4;
}

.gf-subtitle {
  font-family: "AlimamaDongFangDaKai";
  font-size: 24rpx;
  color: #A07345;
  letter-spacing: 4rpx;
  margin-top: 4rpx;
}

/* ── 列表区 ── */
.gf-list {
  padding: 20rpx 24rpx 12rpx;
}

/* ── 列表项 ── */
.gf-item {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid rgba(160, 115, 69, 0.15);
  transition: background 0.2s;
  position: relative;
}

.gf-item:last-child {
  border-bottom: none;
}

.gf-item:active,
.gf-item-active {
  background: rgba(219, 81, 31, 0.05);
}

/* ── 左侧序号 ── */
.gf-item-left {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.gf-item-num {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #A07345;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "AlimamaDongFangDaKai";
  font-size: 24rpx;
  color: #A07345;
  font-weight: 600;
}

.gf-item-active .gf-item-num {
  background: #DB511F;
  border-color: #DB511F;
  color: #F9F9F9;
}

.gf-item-icon {
  width: 56rpx;
  height: 56rpx;
}

/* ── 中间内容 ── */
.gf-item-body {
  flex: 1;
  min-width: 0;
}

.gf-item-title {
  font-family: "AlimamaDongFangDaKai";
  font-size: 30rpx;
  font-weight: 600;
  color: #3a1f0d;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gf-item-desc {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 4rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.gf-item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.gf-tag {
  font-size: 20rpx;
  color: #A07345;
  background: rgba(240, 223, 163, 0.35);
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(160, 115, 69, 0.2);
}

/* ── 右侧箭头 ── */
.gf-item-arrow {
  width: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.gf-arrow-icon {
  font-family: "Georgia", serif;
  font-size: 36rpx;
  color: #A07345;
  font-weight: 300;
  opacity: 0.5;
}

/* ── 底部装饰 ── */
.gf-ornament-bottom {
  display: flex;
  justify-content: center;
  padding: 4rpx 0 16rpx;
}
