/* custom-tab-bar/index.wxss */
/* 国风金色底部导航栏 */

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 999;
  display: flex;
  justify-content: space-around;
  padding-top: 14rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 14rpx);
  background-color: rgba(14, 8, 2, 0.97);
  background-image: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 3rpx,
    rgba(212, 175, 55, 0.018) 3rpx,
    rgba(212, 175, 55, 0.018) 4rpx
  );
  border-top: 1rpx solid rgba(212, 175, 55, 0.4);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.6);
  box-sizing: border-box;
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  padding: 4rpx 0 6rpx;
}

/* ==== 图标容器 ==== */
.tab-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==== 图标 — 用CSS绘制4种国风形状 ==== */
.tab-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

/* 1. 首页 — 菱形（象征皮影戏台幕布） */
.tab-home .icon-shape {
  width: 20rpx;
  height: 20rpx;
  background: rgba(255, 240, 200, 0.35);
  transform: rotate(45deg);
  border: 2rpx solid rgba(255, 240, 200, 0.5);
  transition: all 0.25s;
}

/* 2. 互动馆 — 上三角+下三角（象征光影交错） */
.tab-interactive .icon-shape {
  position: relative;
  width: 0;
  height: 0;
}
.tab-interactive .icon-shape::before,
.tab-interactive .icon-shape::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
}
.tab-interactive .icon-shape::before {
  top: -12rpx;
  left: -10rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 12rpx solid rgba(255, 240, 200, 0.35);
}
.tab-interactive .icon-shape::after {
  top: 0;
  left: -10rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid rgba(255, 240, 200, 0.35);
}

/* 3. 作坊 — 竖线+横线（象征刻刀） */
.tab-workshop .icon-shape {
  position: relative;
  width: 4rpx;
  height: 22rpx;
  background: rgba(255, 240, 200, 0.35);
  border-radius: 2rpx;
}
.tab-workshop .icon-shape::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 3rpx;
  background: rgba(255, 240, 200, 0.35);
  border-radius: 1rpx;
}

/* 4. 我的 — 圆+圆弧（象征人物头像） */
.tab-mine .icon-shape {
  position: relative;
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid rgba(255, 240, 200, 0.5);
  border-radius: 50%;
  background: transparent;
}
.tab-mine .icon-shape::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 8rpx;
  border: 2rpx solid rgba(255, 240, 200, 0.5);
  border-radius: 12rpx 12rpx 0 0;
  border-bottom: none;
}

/* ==== 选中态图标 ==== */
.tab-active .icon-shape,
.tab-active .icon-shape::before,
.tab-active .icon-shape::after {
  border-color: #D4AF37 !important;
  background-color: #D4AF37 !important;
  box-shadow: 0 0 12rpx rgba(212, 175, 55, 0.5);
}

/* 作坊选中（形状是窄条，需要单独处理） */
.tab-active .tab-workshop .icon-shape {
  background: #D4AF37;
}
.tab-active .tab-workshop .icon-shape::after {
  background: #D4AF37;
}

/* ==== 选中态光晕 ==== */
.icon-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.25) 0%, transparent 70%);
  z-index: 1;
  animation: glowPulse 2s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(0.9); }
  50%      { opacity: 0.8; transform: translate(-50%, -50%) scale(1.1); }
}

/* ==== 文字标签 ==== */
.tab-label {
  font-size: 22rpx;
  color: rgba(255, 240, 200, 0.35);
  letter-spacing: 4rpx;
  font-family: "SimSun", "宋体", "Noto Serif CJK SC", serif;
  transition: color 0.25s;
}

.tab-active .tab-label {
  color: #D4AF37;
  font-weight: bold;
  text-shadow: 0 0 10rpx rgba(212, 175, 55, 0.4);
}

/* ==== 顶部指示线 ==== */
.tab-indicator {
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 3rpx;
  background: #D4AF37;
  border-radius: 2rpx;
  box-shadow: 0 0 12rpx rgba(212, 175, 55, 0.9);
}
