/* custom-tab-bar/index.wxss */
/* 国风印章风格底部导航栏 */

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 999;
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding-top: 12rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 10rpx);
  /* 宣纸米底 + 细微纹理 */
  background-color: #1a1008;
  background-image:
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 3rpx,
      rgba(212, 175, 55, 0.015) 3rpx,
      rgba(212, 175, 55, 0.015) 4rpx
    );
  border-top: 1rpx solid rgba(212, 175, 55, 0.35);
  box-shadow:
    0 -2rpx 20rpx rgba(0, 0, 0, 0.5),
    0 -1rpx 0 rgba(212, 175, 55, 0.15);
  box-sizing: border-box;
}

/* ===== 每个Tab ===== */
.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  padding: 6rpx 0;
}

/* ===== 印章图标 ===== */
.seal {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 未选中: 暗金细框 + 半透明底 */
  border: 2rpx solid rgba(212, 175, 55, 0.35);
  background: rgba(212, 175, 55, 0.04);
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

/* 印章内汉字 */
.seal-char {
  font-size: 32rpx;
  color: rgba(212, 175, 55, 0.45);
  font-family: "SimSun", "宋体", "Noto Serif CJK SC", serif;
  font-weight: bold;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ===== 选中态印章 ===== */
.seal-active {
  width: 60rpx;
  height: 60rpx;
  border-color: #D4AF37;
  border-width: 2.5rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.2) 0%, rgba(212, 175, 55, 0.06) 70%);
  box-shadow:
    0 0 20rpx rgba(212, 175, 55, 0.45),
    0 0 40rpx rgba(212, 175, 55, 0.15),
    inset 0 0 20rpx rgba(212, 175, 55, 0.1);
  animation: sealGlow 2s ease-in-out infinite;
}

.seal-active .seal-char {
  color: #D4AF37;
  text-shadow: 0 0 12rpx rgba(212, 175, 55, 0.6);
  font-size: 34rpx;
}

@keyframes sealGlow {
  0%, 100% {
    box-shadow:
      0 0 20rpx rgba(212, 175, 55, 0.45),
      0 0 40rpx rgba(212, 175, 55, 0.15),
      inset 0 0 20rpx rgba(212, 175, 55, 0.1);
  }
  50% {
    box-shadow:
      0 0 30rpx rgba(212, 175, 55, 0.6),
      0 0 60rpx rgba(212, 175, 55, 0.25),
      inset 0 0 30rpx rgba(212, 175, 55, 0.18);
  }
}

/* ===== 标签文字 ===== */
.tab-label {
  font-size: 20rpx;
  color: rgba(255, 240, 200, 0.3);
  letter-spacing: 4rpx;
  font-family: "SimSun", "宋体", "Noto Serif CJK SC", serif;
  transition: all 0.3s;
}

.label-active {
  color: #D4AF37;
  font-weight: bold;
  text-shadow: 0 0 8rpx rgba(212, 175, 55, 0.4);
  letter-spacing: 6rpx;
}
