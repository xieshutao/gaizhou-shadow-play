/* custom-tab-bar/index.wxss */
/* 国风底部导航栏 — ICHStudy 图标风格 */

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 999;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-top: 10rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 10rpx);
  /* 宣纸米底 + 细微纹理 */
  background-color: #1a1008;
  background-image:
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 3rpx,
      rgba(212, 175, 55, 0.015) 3rpx,
      rgba(212, 175, 55, 0.015) 4rpx
    );
  border-top: 1rpx solid rgba(212, 175, 55, 0.35);
  box-shadow:
    0 -2rpx 20rpx rgba(0, 0, 0, 0.5),
    0 -1rpx 0 rgba(212, 175, 55, 0.15);
  box-sizing: border-box;
}

/* ===== 每个Tab ===== */
.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  padding: 4rpx 0;
}

/* ===== 图标 ===== */
.tab-icon {
  width: 48rpx;
  height: 48rpx;
  transition: all 0.3s ease;
}

.tab-active .tab-icon {
  filter: drop-shadow(0 0 8rpx rgba(212, 175, 55, 0.5));
  transform: scale(1.08);
}

/* ===== 标签文字 ===== */
.tab-label {
  font-size: 20rpx;
  color: rgba(255, 240, 200, 0.35);
  letter-spacing: 4rpx;
  font-family: "SimSun", "宋体", serif;
  transition: all 0.3s;
}

.label-active {
  color: #D4AF37;
  font-weight: bold;
  text-shadow: 0 0 8rpx rgba(212, 175, 55, 0.4);
  letter-spacing: 6rpx;
}
