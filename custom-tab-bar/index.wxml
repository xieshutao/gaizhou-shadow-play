<!-- custom-tab-bar/index.wxml -->
<!-- 国风印章风格底部导航栏 -->

<view class="tabbar">
  <view
    class="tab-item {{selected === index ? 'tab-active' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <!-- 印章图标 -->
    <view class="seal {{selected === index ? 'seal-active' : ''}}">
      <text class="seal-char">{{item.iconChar}}</text>
    </view>

    <!-- 标签 -->
    <text class="tab-label {{selected === index ? 'label-active' : ''}}">{{item.text}}</text>
  </view>
</view>
