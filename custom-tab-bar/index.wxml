<!-- custom-tab-bar/index.wxml -->
<!-- 国风底部导航栏 — 使用 ICHStudy 图标 -->

<view class="tabbar">
  <view
    class="tab-item {{selected === index ? 'tab-active' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <!-- 图标 -->
    <image 
      class="tab-icon" 
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
    />
    <!-- 标签 -->
    <text class="tab-label {{selected === index ? 'label-active' : ''}}">{{item.text}}</text>
  </view>
</view>
