/* pages/create-play/create-play.wxss */
/* 盖州皮影 · AI 造戏 */

page { height: 100vh; background: #000; overflow: hidden; }
.page-root { position: relative; width: 100vw; height: 100vh; overflow-y: auto; }

/* 暗纹背景 */
.bg-layer {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0;
  background:
    radial-gradient(ellipse at 70% 20%, rgba(212,175,55,0.04) 0%, transparent 70%),
    radial-gradient(ellipse at 30% 80%, rgba(180,120,30,0.03) 0%, transparent 60%),
    linear-gradient(180deg, #0a0402 0%, #0d0603 50%, #060201 100%);
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 3rpx, rgba(212,175,55,0.012) 3rpx, rgba(212,175,55,0.012) 4rpx),
    repeating-linear-gradient(90deg, transparent, transparent 3rpx, rgba(180,120,30,0.008) 3rpx, rgba(180,120,30,0.008) 4rpx);
}

/* ======== 输入阶段 ======== */
.input-phase, .result-phase {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
  padding: calc(env(safe-area-inset-top) + 60rpx) 36rpx 0;
  min-height: 100vh;
}

/* 标题 */
.cp-title-area {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  margin-bottom: 40rpx;
}
.cp-title {
  font-size: 56rpx; font-weight: bold; color: #D4AF37;
  letter-spacing: 18rpx; font-family: "SimSun","宋体",serif;
  text-shadow: 0 0 30rpx rgba(212,175,55,0.4), 0 2rpx 8rpx rgba(0,0,0,0.8);
}
.cp-subtitle {
  font-size: 22rpx; color: rgba(255,255,255,0.35); letter-spacing: 4rpx;
}

/* 关键词输入 */
.input-area {
  position: relative; width: 100%; margin-bottom: 20rpx;
}
.keyword-input {
  width: 100%; height: 88rpx; padding: 0 32rpx;
  background: rgba(255,255,255,0.04); border: 1rpx solid rgba(212,175,55,0.18);
  border-radius: 8rpx; color: #D4AF37; font-size: 28rpx;
  letter-spacing: 3rpx; text-align: center; box-sizing: border-box;
}
.keyword-input::placeholder { color: rgba(255,255,255,0.18); }
.input-deco-l, .input-deco-r {
  position: absolute; top: 50%; width: 16rpx; height: 2rpx;
  background: rgba(212,175,55,0.3); transform: translateY(-50%);
}
.input-deco-l { left: -22rpx; }
.input-deco-r { right: -22rpx; }

/* 匹配提示 */
.match-hint {
  display: flex; align-items: center; gap: 10rpx;
  padding: 8rpx 24rpx; margin-bottom: 30rpx;
  border: 1rpx solid rgba(212,175,55,0.15); border-radius: 20rpx;
  background: rgba(212,175,55,0.05);
}
.match-hint text { font-size: 20rpx; color: rgba(212,175,55,0.5); }
.hint-icon { color: #D4AF37; font-size: 22rpx; }

/* ======== 选择器 ======== */
.picker-section {
  width: 100%; display: flex; flex-direction: column; gap: 24rpx;
  margin-bottom: 30rpx;
}
.picker-row {
  display: flex; align-items: flex-start; gap: 16rpx;
}
.picker-label {
  display: flex; flex-direction: column; align-items: center;
  width: 56rpx; padding-top: 6rpx; flex-shrink: 0;
}
.label-num {
  font-size: 22rpx; color: #D4AF37; font-weight: bold;
  border: 1rpx solid rgba(212,175,55,0.4);
  border-radius: 4rpx; padding: 2rpx 10rpx; margin-bottom: 4rpx;
}
.label-text {
  font-size: 18rpx; color: rgba(255,255,255,0.3); letter-spacing: 4rpx;
  writing-mode: vertical-lr;
}
.picker-scroll { flex: 1; overflow: hidden; }
.picker-items { display: flex; gap: 16rpx; white-space: nowrap; }
.picker-chip {
  display: flex; align-items: center; gap: 8rpx;
  padding: 12rpx 24rpx; flex-shrink: 0;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  background: rgba(255,255,255,0.03);
  transition: all 0.2s;
}
.picker-chip:active { transform: scale(0.96); }
.chip-active {
  border-color: #D4AF37; background: rgba(212,175,55,0.12);
  box-shadow: 0 0 16rpx rgba(212,175,55,0.15);
}
.chip-era, .chip-role {
  font-size: 18rpx; color: #D4AF37;
  border: 1rpx solid rgba(212,175,55,0.4); border-radius: 4rpx;
  padding: 2rpx 8rpx;
}
.chip-name { font-size: 24rpx; color: rgba(255,255,255,0.75); }
.chip-active .chip-name { color: #D4AF37; }

/* 生成按钮 */
.gen-btn-wrap {
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
  margin: 20rpx 0 40rpx;
}
.gen-btn { width: 420rpx; padding: 20rpx 0; }
.gen-btn text { font-size: 30rpx; font-weight: bold; letter-spacing: 8rpx; }
.gen-hint {
  font-size: 20rpx; color: rgba(255,255,255,0.2); letter-spacing: 2rpx;
}

/* ======== 结果阶段 ======== */
.rp-title-area {
  display: flex; flex-direction: column; align-items: center;
  gap: 8rpx; margin-bottom: 36rpx;
}
.rp-title {
  font-size: 40rpx; color: #D4AF37; font-weight: bold;
  letter-spacing: 12rpx; font-family: "SimSun","宋体",serif;
}
.rp-subtitle {
  font-size: 20rpx; color: rgba(255,255,255,0.25); letter-spacing: 2rpx;
}

/* 结果卡片 */
.result-cards {
  width: 100%; display: flex; flex-direction: column;
  gap: 20rpx; margin-bottom: 30rpx;
}
.result-card {
  position: relative;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(212,175,55,0.2);
  border-radius: 4rpx;
  background: rgba(28,16,6,0.85);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.4);
}
.rc-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.rc-num {
  font-size: 20rpx; color: #D4AF37; font-weight: bold;
  border: 1rpx solid rgba(212,175,55,0.4); padding: 2rpx 10rpx; border-radius: 4rpx;
}
.rc-type {
  font-size: 18rpx; color: rgba(255,255,255,0.3);
  letter-spacing: 4rpx; padding: 2rpx 12rpx;
  border: 1rpx solid rgba(255,255,255,0.1); border-radius: 4rpx;
}
.rc-era, .rc-role {
  font-size: 18rpx; color: #D4AF37;
  border: 1rpx solid rgba(212,175,55,0.4); padding: 2rpx 10rpx; border-radius: 4rpx;
}
.rc-name {
  display: block; font-size: 36rpx; font-weight: bold; color: #D4AF37;
  letter-spacing: 6rpx; margin-bottom: 10rpx;
  font-family: "SimSun","宋体",serif;
}
.rc-desc {
  display: block; font-size: 24rpx; color: rgba(255,240,210,0.6);
  line-height: 1.8; letter-spacing: 1rpx;
}
.rc-deco {
  position: absolute; bottom: 0; left: 20rpx; right: 20rpx;
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(212,175,55,0.2), transparent);
}

/* 操作按钮 */
.rp-actions {
  display: flex; justify-content: center; margin-bottom: 160rpx;
}
.reset-btn { padding: 16rpx 60rpx; border-radius: 8rpx; }

/* ======== 底部导航 ======== */
.tabbar {
  position: fixed; bottom: 0; left: 0; width: 100%; z-index: 20;
  display: flex; justify-content: space-around;
  padding-top: 16rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  background: linear-gradient(to top, rgba(0,0,0,0.94) 0%, rgba(0,0,0,0.5) 100%);
  border-top: 1rpx solid rgba(212,175,55,0.18);
}
.tab-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; flex: 1; }
.tab-icon  { font-size: 40rpx; color: rgba(255,255,255,0.35); }
.tab-label { font-size: 22rpx; color: rgba(255,255,255,0.35); }
.tab-active .tab-icon, .tab-active .tab-label { color: #D4AF37; font-weight: bold; }

/* ======== 通用分隔线 ======== */
.gold-divider {
  width: 360rpx; height: 1rpx; margin-top: 8rpx;
  background: linear-gradient(to right, transparent, rgba(212,175,55,0.4), transparent);
}
