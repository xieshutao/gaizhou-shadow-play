/* index.wxss */

page {
  height: 100vh;
  background: #000;
}

/* ── 全局容器 ── */
.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* ── 背景图 z-index:1 ── */
.bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* ── 左上角标题区域 z-index:10 ── */
.title-area {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding-top: calc(env(safe-area-inset-top) + 88rpx);
  padding-left: 40rpx;
  padding-right: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.title-img {
  width: 530rpx;
}

.subtitle-wrap {
  margin-top: 12rpx;
}

.subtitle-en {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 4rpx;
  font-family: serif;
  line-height: 1.6;
}

.subtitle-gold {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #D4AF37;
  letter-spacing: 3rpx;
  white-space: nowrap;
}

/* 副标题行：文字 + 图标（右对齐） */
.subtitle-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-top: 6rpx;
}

/* ── 左侧导航菜单 z-index:10 ── */
.left-nav {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48rpx;
  padding: 40rpx 18rpx;
  background: linear-gradient(
    to right,
    rgba(0, 0, 0, 0.68) 0%,
    rgba(0, 0, 0, 0.08) 100%
  );
  border-radius: 0 28rpx 28rpx 0;
  border-right: 1rpx solid rgba(212, 175, 55, 0.18);
  border-top: 1rpx solid rgba(212, 175, 55, 0.12);
  border-bottom: 1rpx solid rgba(212, 175, 55, 0.12);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.nav-icon {
  width: 96rpx;
  height: 96rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(212, 175, 55, 0.35));
}

.nav-text {
  font-size: 20rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
  writing-mode: horizontal-tb;
  font-family: "SimSun", "宋体", serif;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.8);
}

/* ── 舞台区域 z-index:5 ── */
.stage-wrap {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  width: 100%;
  display: flex;
  justify-content: center;
}

.stage-img {
  width: 92%;
}

/* ── 古风卡片（基于用户上传设计稿）── */
.gf-card-area {
  position: absolute;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  width: 560rpx;
}

.gf-card-box {
  background: #F9F9F9;
  border: 2rpx solid #A07345;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(160,115,69,0.15);
}

.gf-deco-top {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 0;
  gap: 12rpx;
}
.gf-deco-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #A07345, transparent);
}
.gf-deco-diamond {
  width: 12rpx;
  height: 12rpx;
  background: #DB511F;
  transform: rotate(45deg);
  opacity: 0.7;
}
.gf-deco-bot {
  display: flex;
  justify-content: center;
  padding: 4rpx 0 16rpx;
}

.gf-title {
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #DB511F;
  letter-spacing: 6rpx;
  padding: 8rpx 32rpx 0;
  font-family: "KaiTi","STKaiti","楷体",serif;
}
.gf-subtitle {
  text-align: center;
  font-size: 22rpx;
  color: #A07345;
  letter-spacing: 4rpx;
  padding: 4rpx 32rpx 0;
  font-family: "KaiTi","STKaiti","楷体",serif;
}

.gf-list {
  padding: 16rpx 24rpx 6rpx;
}

.gf-item {
  display: flex;
  align-items: center;
  padding: 18rpx 10rpx;
  border-bottom: 1rpx solid rgba(160,115,69,0.12);
}
.gf-item:last-child { border-bottom: none; }
.gf-item:active { background: rgba(219,81,31,0.04); }

.gf-num {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #A07345;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #A07345;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.gf-body { flex:1; min-width:0; }
.gf-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3a1f0d;
  font-family: "KaiTi","STKaiti","楷体",serif;
}
.gf-item-desc {
  font-size: 22rpx;
  color: #8b7355;
  margin-top: 2rpx;
}
.gf-tags { display:flex; gap:8rpx; margin-top:6rpx; }
.gf-tag {
  font-size: 18rpx;
  color: #A07345;
  background: rgba(240,223,163,0.35);
  padding: 1rpx 10rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(160,115,69,0.2);
}

.gf-arrow {
  font-size: 32rpx;
  color: #A07345;
  opacity: 0.4;
  flex-shrink: 0;
  width: 36rpx;
  text-align: center;
}

/* ── 音乐图标（副标题行内，右对齐）── */
.music-icon {
  flex-shrink: 0;
  margin-left: auto;
  margin-top: 8rpx;
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(20, 12, 4, 0.6);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  transition: all 0.3s;
}

.mi-note {
  font-size: 32rpx;
  color: rgba(212, 175, 55, 0.6);
  transition: color 0.3s;
}

.music-playing {
  border-color: #D4AF37;
  box-shadow: 0 0 12rpx rgba(212, 175, 55, 0.3);
  animation: iconSpin 4s linear infinite;
}

.music-playing .mi-note {
  color: #D4AF37;
}

@keyframes iconSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ── 右侧悬浮按钮 z-index:10 ── */
.float-btn {
  position: absolute;
  right: 28rpx;
  bottom: 260rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 76rpx;
  padding: 24rpx 0;
  border: 1rpx solid rgba(212, 175, 55, 0.8);
  border-radius: 38rpx;
  background: linear-gradient(
    180deg,
    rgba(18, 12, 2, 0.82) 0%,
    rgba(30, 20, 4, 0.75) 100%
  );
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.5), 0 0 16rpx rgba(212, 175, 55, 0.15), inset 0 1rpx 0 rgba(212, 175, 55, 0.25);
}

.play-icon {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 6rpx;
  opacity: 0.85;
}

.btn-text {
  font-size: 22rpx;
  color: #D4AF37;
  letter-spacing: 2rpx;
  line-height: 1.6;
  font-family: "SimSun", "宋体", serif;
  font-weight: bold;
  text-shadow: 0 0 10rpx rgba(212, 175, 55, 0.5);
}

/* ── 底部导航栏 z-index:20 ── */
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 20;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding-top: 20rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  background-color: rgba(14, 8, 2, 0.97);
  background-image: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 3rpx,
    rgba(212, 175, 55, 0.018) 3rpx,
    rgba(212, 175, 55, 0.018) 4rpx
  );
  border-top: 1rpx solid rgba(212, 175, 55, 0.4);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.6);
  box-sizing: border-box;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  padding: 4rpx 0 8rpx;
  position: relative;
}

.tab-icon {
  font-size: 32rpx;
  color: rgba(255, 240, 200, 0.3);
  font-family: "SimSun", "宋体", serif;
  letter-spacing: 0;
  line-height: 1;
}

.tab-label {
  font-size: 24rpx;
  color: rgba(255, 240, 200, 0.3);
  letter-spacing: 4rpx;
  font-family: "SimSun", "宋体", serif;
  font-weight: normal;
}

/* 激活态：金色 + 顶部细线指示 */
.tab-active::before {
  content: "";
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 3rpx;
  background: #D4AF37;
  border-radius: 2rpx;
  box-shadow: 0 0 10rpx rgba(212, 175, 55, 0.9);
}

.tab-active .tab-icon {
  color: #D4AF37;
  text-shadow: 0 0 16rpx rgba(212, 175, 55, 0.7);
}

.tab-active .tab-label {
  color: #D4AF37;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-shadow: 0 0 10rpx rgba(212, 175, 55, 0.4);
}
