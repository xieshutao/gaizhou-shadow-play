/* pages/knowledge/knowledge.wxss */
/* 皮影百科 · 知识馆 */

page { height: 100vh; background: #000; overflow: hidden; }
.page-root { position: relative; width: 100vw; height: 100vh; }

/* 主滚动区 */
.main-scroll {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 2; overflow-y: auto;
}

/* 暗纹背景 */
.main-scroll::before {
  content: ''; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
  background:
    radial-gradient(ellipse at 50% 10%, rgba(212,175,55,0.05) 0%, transparent 60%),
    linear-gradient(180deg, #0a0402 0%, #0d0603 40%, #060201 100%);
}

/* ===== 顶部标题 ===== */
.header {
  display: flex; align-items: center; justify-content: center;
  padding-top: calc(env(safe-area-inset-top) + 80rpx);
  padding-bottom: 40rpx; gap: 24rpx;
}
.header-deco-l, .header-deco-r {
  width: 60rpx; height: 2rpx;
  background: linear-gradient(to right, transparent, rgba(212,175,55,0.5));
}
.header-deco-r {
  background: linear-gradient(to left, transparent, rgba(212,175,55,0.5));
}
.header-text { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.header-title {
  font-size: 52rpx; font-weight: bold; color: #D4AF37;
  letter-spacing: 20rpx; font-family: "SimSun","宋体",serif;
  text-shadow: 0 0 30rpx rgba(212,175,55,0.4);
}
.header-subtitle {
  font-size: 22rpx; color: rgba(255,255,255,0.3);
  letter-spacing: 6rpx; font-family: "SimSun","宋体",serif;
}

/* ===== 章节通用 ===== */
.section {
  padding: 0 36rpx; margin-bottom: 48rpx;

  /* 交错淡入 */
  opacity: 0;
  animation: fadeIn 0.8s ease-out forwards;
}
.section:nth-child(2) { animation-delay: 0.1s; }
.section:nth-child(3) { animation-delay: 0.2s; }
.section:nth-child(4) { animation-delay: 0.3s; }
.section:nth-child(5) { animation-delay: 0.4s; }
.section:nth-child(6) { animation-delay: 0.5s; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 章节标题 */
.section-title {
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx; margin-bottom: 28rpx;
}
.st-deco {
  width: 40rpx; height: 1rpx;
  background: rgba(212,175,55,0.3);
}
.st-num {
  font-size: 28rpx; color: #D4AF37; font-weight: bold;
  border: 1rpx solid rgba(212,175,55,0.4);
  border-radius: 4rpx; padding: 4rpx 16rpx;
}
.st-text {
  font-size: 36rpx; color: #D4AF37;
  letter-spacing: 12rpx; font-family: "SimSun","宋体",serif;
}

/* 章节卡片 */
.section-card { padding: 32rpx; }
.card-body {
  font-size: 26rpx; color: rgba(255,240,210,0.7);
  line-height: 2.1; letter-spacing: 2rpx;
  white-space: pre-line;
}

/* ===== 特色网格 ===== */
.feature-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.feature-item {
  width: calc(50% - 8rpx); padding: 28rpx 24rpx;
  display: flex; flex-direction: column; gap: 10rpx;
  box-sizing: border-box;
}
.fi-icon { font-size: 40rpx; }
.fi-title {
  font-size: 28rpx; color: #D4AF37; font-weight: bold;
  letter-spacing: 4rpx;
}
.fi-desc {
  font-size: 22rpx; color: rgba(255,240,210,0.55);
  line-height: 1.7; letter-spacing: 1rpx;
}

/* ===== 工艺步骤 ===== */
.craft-steps {
  display: flex; flex-direction: column; gap: 0;
  padding-left: 32rpx; border-left: 2rpx solid rgba(212,175,55,0.15);
}
.craft-step {
  display: flex; gap: 20rpx; margin-bottom: 24rpx;
}
.cs-num-wrap {
  display: flex; flex-direction: column; align-items: center;
  flex-shrink: 0; width: 50rpx;
}
.cs-num {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(212,175,55,0.15); border: 1rpx solid #D4AF37;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #D4AF37; font-weight: bold;
}
.cs-line {
  flex: 1; width: 2rpx; background: rgba(212,175,55,0.15);
  min-height: 60rpx;
}
.cs-content { flex: 1; padding: 24rpx; }
.cs-title {
  display: block; font-size: 28rpx; color: #D4AF37; font-weight: bold;
  letter-spacing: 6rpx; margin-bottom: 8rpx;
}
.cs-desc {
  display: block; font-size: 22rpx; color: rgba(255,240,210,0.55);
  line-height: 1.7; letter-spacing: 1rpx;
}

/* ===== 剧目列表 ===== */
.play-list {
  display: flex; flex-direction: column; gap: 16rpx;
}
.play-item { padding: 28rpx; }
.pi-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12rpx;
}
.pi-name {
  font-size: 32rpx; color: #D4AF37; font-weight: bold;
  letter-spacing: 6rpx; font-family: "SimSun","宋体",serif;
}
.pi-era {
  font-size: 20rpx; color: rgba(212,175,55,0.5); border: 1rpx solid rgba(212,175,55,0.25);
  padding: 2rpx 12rpx; border-radius: 4rpx;
}
.pi-desc {
  display: block; font-size: 24rpx; color: rgba(255,240,210,0.55);
  line-height: 1.8; letter-spacing: 1rpx;
}

/* ===== 底部 ===== */
.bottom-spacer { height: 160rpx; }

/* ===== 导航 ===== */
.tabbar {
  position: fixed; bottom: 0; left: 0; width: 100%; z-index: 20;
  display: flex; justify-content: space-around;
  padding-top: 16rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  background: linear-gradient(to top, rgba(0,0,0,0.96) 0%, rgba(0,0,0,0.6) 100%);
  border-top: 1rpx solid rgba(212,175,55,0.2);
}
.tab-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; flex: 1; }
.tab-icon  { font-size: 40rpx; color: rgba(255,255,255,0.35); }
.tab-label { font-size: 22rpx; color: rgba(255,255,255,0.35); }
.tab-active .tab-icon, .tab-active .tab-label { color: #D4AF37; font-weight: bold; }
